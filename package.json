{
  "name": "proyeccion",
  "version": "0.1.0-alpha.8",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./vegachart": "./src/vegachart.js",
    "./mcp": "./src/mcp.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs/conformance.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:shared": "vite --config examples/shared-vite.js",
    "build": "vite build --base=./",
    "test": "node --test --test-concurrency=1",
    "check:package": "node tools/check_package.js",
    "check:mcp-stateful": "node --test tools/check_mcp_stateful.js"
  },
  "dependencies": {
    "@a2ui/lit": "0.16.0",
    "@a2ui/markdown-it": "0.2.3",
    "@a2ui/web_core": "0.16.1",
    "@lit/context": "1.1.6",
    "fast-json-patch": "3.1.2",
    "lit": "3.3.3"
  },
  "peerDependencies": {
    "three": ">=0.182.0 <0.183",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.1",
    "@a2ui/catalog-mcp": "0.1.1"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@a2ui/agent": "0.2.1",
    "@a2ui/catalog-mcp": "0.1.1",
    "@ag-ui/a2ui-middleware": "0.0.16",
    "@ag-ui/client": "1.0.5",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axe-core": "4.10.3",
    "playwright-core": "1.60.0",
    "rxjs": "7.8.1",
    "three": "0.182.0",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.4.1",
    "vite": "6.4.1",
    "ws": "8.23.0",
    "yaml": "2.8.2",
    "zod": "3.25.76"
  },
  "description": "Mount A2UI 1.0 surfaces in browser-based Three.js scenes.",
  "license": "MIT",
  "homepage": "https://github.com/AlterMundi/proyeccion",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlterMundi/proyeccion.git"
  },
  "bugs": {
